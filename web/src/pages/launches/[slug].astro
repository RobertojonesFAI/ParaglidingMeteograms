---
import Base from "../../layouts/Base.astro";
import { launches } from "../../lib/catalog.ts";
import { compassPoint, type Launch } from "../../lib/launches.ts";

export function getStaticPaths() {
  return launches.map((launch) => ({ params: { slug: launch.slug }, props: { launch } }));
}

const { launch } = Astro.props as { launch: Launch };
const facing = compassPoint(launch.facingDeg);
const zoneName =
  new Intl.DateTimeFormat("en-US", { timeZone: launch.timeZone, timeZoneName: "long" })
    .formatToParts(new Date())
    .find((p) => p.type === "timeZoneName")?.value ?? launch.timeZone;
---

<Base title={launch.name} description={`Soaring meteogram and National Weather Service forecast for ${launch.name}.`}>
  <script type="application/json" id="launch-config" set:html={JSON.stringify(launch)} />

  <p class="eyebrow"><a href="/">Launches</a>{launch.region && ` · ${launch.region}`}</p>
  <h1>{launch.name}</h1>
  <ul class="facts">
    <li>Faces <strong>{facing}</strong> ({launch.facingDeg}°)</li>
    <li>Launch range <strong>{launch.windMinMph}–{launch.windMaxMph} mph</strong>, gusts under {launch.gustMaxMph}</li>
    <li id="launch-elevation-item" hidden>Launch elevation <strong id="launch-elevation"></strong></li>
    <li>Times in {zoneName}</li>
  </ul>
  {launch.notes && <p class="notice" style="margin-top:14px">{launch.notes}</p>}

  <p id="sample-notice" class="notice sample" style="margin-top:14px" hidden>
    Sample data for local development. This is not a forecast.
  </p>

  <div class="controls">
    <div>
      <span class="control-label" id="day-label">Day</span>
      <div class="segmented" id="day-tabs" role="group" aria-labelledby="day-label"></div>
    </div>
    <div>
      <span class="control-label" id="model-label">Model</span>
      <div class="segmented" id="model-tabs" role="group" aria-labelledby="model-label"></div>
    </div>
  </div>

  <section class="card" aria-labelledby="meteogram-title">
    <div class="card-head">
      <h2 id="meteogram-title">Soaring meteogram</h2>
      <span class="card-sub" id="meteogram-meta"></span>
    </div>
    <div class="chart-scroll meteogram-frame" id="meteogram">
      <p class="chart-status">Loading the model forecast…</p>
    </div>
    <details style="margin-top:14px">
      <summary>How to read this chart</summary>
      <p class="muted" style="margin-bottom:10px">
        Time runs left to right; height above sea level runs up. The lines show how high thermals are expected to reach
        (boundary layer top, usable lift top, cloud base), the barbs show wind at each height (km/h), and the strips below
        show surface conditions. The green and red marks under the hours compare the surface wind with this launch's wind
        window ({facing} ±{launch.windArcHalfWidthDeg}°).
        <a href="https://meteo.azohra.com/docs/briefing/reading-a-meteogram/">Full guide to every mark</a>.
      </p>
      <div class="chart-scroll" id="meteogram-key"></div>
    </details>
  </section>

  <section class="card" id="sun-section" aria-labelledby="sun-title">
    <div class="card-head">
      <h2 id="sun-title">Sunlight on the terrain</h2>
      <span class="card-sub"><span id="sun-daylight"></span> · <span id="sun-cloud-note"></span></span>
    </div>
    <p class="chart-status" id="sun-status">Scroll here to load the sunlight map.</p>
    <div id="sun-body" hidden>
      <div class="map sun-map" id="sun-map" tabindex="0" aria-label="Map of sunlight on the ground around the launch. Click a spot to see its day."></div>
      <div class="sun-controls">
        <button type="button" class="button secondary" id="sun-play" aria-pressed="false">Play</button>
        <label class="sun-slider">
          <span class="sr-only">Time of day</span>
          <input type="range" id="sun-time" min="0" max="0" step="1" value="0" />
        </label>
        <output id="sun-time-label" for="sun-time" class="sun-time">–</output>
      </div>
      <div class="sun-options">
        <div class="sun-legend" aria-label="Colour scale: sunlight in watts per square metre">
          <div class="sun-legend-bar" id="sun-legend-bar"></div>
          <div class="sun-legend-ticks" id="sun-legend-ticks"></div>
          <span class="sun-legend-unit">W/m² reaching the ground</span>
        </div>
        <div class="sun-buttons">
          <button type="button" class="button secondary" id="sun-peak" disabled>Peak</button>
          <label class="sun-check"><input type="checkbox" id="sun-clouds" checked /> Forecast clouds</label>
        </div>
      </div>
      <div class="sun-point-head">
        <strong id="sun-point"></strong>
        <button type="button" class="link-button" id="sun-reset" hidden>Back to the launch</button>
      </div>
      <p class="sun-readout" id="sun-readout" role="status" aria-live="polite"></p>
      <div class="sun-curve" id="sun-curve"></div>
      <details style="margin-top:10px">
        <summary>Table</summary>
        <table class="sun-table">
          <thead><tr><th scope="col">Time</th><th scope="col">W/m²</th></tr></thead>
          <tbody id="sun-table"></tbody>
        </table>
      </details>
      <details style="margin-top:10px">
        <summary>How this is calculated</summary>
        <p class="muted">
          Darker orange means more sunlight reaching the ground, and more heating to set off thermals. For every spot the map
          uses the slope and the direction the ground faces (from a 10 m elevation model), whether a ridge up to 20 km away
          hides the sun, and how much open sky the spot sees. The sun's position is computed for every 15 minutes from sunrise
          to sunset. <span id="sun-terrain"></span>.
        </p>
        <p class="muted">
          A clear sky is dimmed by the cloud cover of the model selected above, at the launch, so a cloud over one ridge but
          not the next does not show. Haze and smoke are not included. Tap or click anywhere on the map to see that spot's day.
        </p>
      </details>
    </div>
  </section>

  <section class="card" aria-labelledby="nws-title">
    <div class="card-head">
      <h2 id="nws-title">National Weather Service forecast</h2>
      <span class="card-sub"><span id="nws-meta"></span> · <a id="nws-link" hidden>Open on weather.gov</a></span>
    </div>
    <div id="nws-charts">
      <p class="chart-status">Loading the NWS forecast…</p>
    </div>
  </section>

  <section class="card" aria-labelledby="ecmwf-title">
    <div class="card-head">
      <h2 id="ecmwf-title">ECMWF forecast</h2>
      <span class="card-sub" id="ecmwf-meta"></span>
    </div>
    <div id="ecmwf-charts">
      <p class="chart-status">Loading the ECMWF forecast…</p>
    </div>
    <details style="margin-top:14px">
      <summary>About this forecast</summary>
      <p class="muted">
        The European Centre for Medium-Range Weather Forecasts' IFS model, at 9 km, for the grid point nearest the launch.
        Winds at 850 and 700 hPa come from its 0.25° run. The boundary-layer height is roughly how deep the air near the
        ground is mixing, a rough ceiling for thermals like the NWS mixing height. ECMWF's open data has no surface heat
        flux, so it cannot drive the soaring meteogram's thermal strength.
      </p>
    </details>
  </section>

  <section class="card" aria-labelledby="text-title">
    <div class="card-head">
      <h2 id="text-title">Forecast discussion</h2>
      <span class="card-sub">National Weather Service text products</span>
    </div>
    <ul class="periods" id="nws-periods"></ul>
    <div class="stack" id="nws-products" style="margin-top:18px"></div>
  </section>

  <script>
    import "../../scripts/launch-page.ts";
  </script>
</Base>
