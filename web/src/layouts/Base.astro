---
import "../styles/global.css";
import { SITE_NAME, SITE_TAGLINE } from "../lib/site.ts";

interface Props {
  title?: string;
  description?: string;
  current?: "launches" | "about" | "admin";
}

const { title, description = SITE_TAGLINE, current } = Astro.props;
const pageTitle = title ? `${title} · ${SITE_NAME}` : SITE_NAME;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#fcfcfb" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1a1a19" media="(prefers-color-scheme: dark)" />
  </head>
  <body>
    <a class="sr-only" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="container">
        <a class="brand" href="/">
          <svg width="26" height="26" viewBox="0 0 32 32" aria-hidden="true">
            <path d="M3 13c6-6 20-6 26 0l-3 2c-5-4-15-4-20 0z" fill="currentColor" />
            <path d="M7 15l9 11 9-11" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
            <circle cx="16" cy="27" r="1.8" fill="currentColor" />
          </svg>
          <span>{SITE_NAME}</span>
        </a>
        <nav class="site-nav" aria-label="Main">
          <a href="/" aria-current={current === "launches" ? "page" : undefined}>Launches</a>
          <a href="/about" aria-current={current === "about" ? "page" : undefined}>About</a>
        </nav>
      </div>
    </header>
    <main id="main">
      <div class="container">
        <slot />
      </div>
    </main>
    <footer class="site-footer">
      <div class="container">
        <p>
          Model data: NOAA (HRRR, RRFS, GFS) and Environment and Climate Change Canada (HRDPS, RDPS, GDPS, GEPS, under the
          <a href="https://eccc-msc.github.io/open-data/licence/readme_en/">Data Server End-use Licence</a>), processed with
          <a href="https://meteo.azohra.com/">meteo by Azohra</a>. Terrain:
          <a href="https://www.usgs.gov/3d-elevation-program">USGS 3DEP</a>. Official
          forecasts: <a href="https://www.weather.gov/">National Weather Service</a>. ECMWF IFS forecasts: ©
          <a href="https://www.ecmwf.int/">ECMWF</a>, <a href="https://creativecommons.org/licenses/by/4.0/">CC BY 4.0</a>, via
          <a href="https://open-meteo.com/">Open-Meteo.com</a>.
        </p>
        <p>These are forecasts, not observations. Always check conditions at launch and fly within your own limits.</p>
      </div>
    </footer>
  </body>
</html>
